[server]
  ## Defines the IP address and port the HTTP server listens on.
  ## Bind to localhost when running behind a reverse proxy (recommended).
  address = "127.0.0.1:9090"
  ## External URL the pairing service is reachable at (used to build
  ## the pre-rendered installer one-liners returned by POST /).
  url = "https://pairing.proxiport.net"
  ## Single origin allowed to make cross-origin (browser) requests to the
  ## deposit/retrieve endpoints. Empty by default (no CORS) — these endpoints
  ## are normally called by provisioning tooling, not a browser. Set to a
  ## specific origin if you front them with a web app. Never use "*".
  #cors_allow_origin = "https://app.example.com"
  ## Shared secret required on the deposit endpoint (POST /). Empty by default,
  ## which leaves deposits unauthenticated (existing behavior). When set, the
  ## depositor — the ProxiPort server — must send it as an
  ## "Authorization: Bearer <token>" header; requests without a matching token
  ## are rejected with 401.
  #deposit_auth_token = "change-me-to-a-long-random-string"
  ## Reverse-proxy CIDRs (or bare IPs) allowed to set X-Forwarded-For /
  ## X-Real-IP. Empty by default: the per-IP rate limiter keys on the direct
  ## peer address. Set this to your proxy's address(es) when running behind one
  ## so limits apply per real client instead of collapsing to a single bucket.
  #trusted_proxies = ["10.0.0.0/8", "192.168.0.0/16"]

[static-deposit]
  ## A static pairing code that bypasses the cache. Useful for
  ## rendering-only tests (shellcheck / PSScriptAnalyzer) without
  ## needing a deposit step. Must be 7 alphanumeric characters.
  code = "0000000"
  connect_url = "http://proxiport.example.com:8080"
  fingerprint = "2a:c4:79:04:80:ba:7c:60:05:e5:2c:49:6d:74:56:24"
  client_id = "client1"
  password = "foobaz"
